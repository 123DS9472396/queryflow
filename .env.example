# ── ClickHouse Cloud ─────────────────────────────────────────────────────────
CH_HOST=wnq090x4ws.ap-south-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=your_clickhouse_password_here
CH_DATABASE=nyc_taxi

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Upstash Kafka (free tier — https://console.upstash.com) ──────────────────
# Sign up free → Create Cluster → Copy these values from Details tab
KAFKA_BROKER=your-cluster.upstash.io:9092
KAFKA_USERNAME=your_upstash_username
KAFKA_PASSWORD=your_upstash_password
KAFKA_TOPIC=nyc-taxi-events

# ── Cloudflare R2 (free S3-compatible — https://dash.cloudflare.com/r2) ──────
# R2 → Manage R2 API Tokens → Create Token → Copy these values
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=queryflow-datalake
